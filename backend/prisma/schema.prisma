generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rol {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique @db.VarChar(20)
  usuarios Usuario[]

  @@map("roles")
}

model Usuario {
  id                  Int               @id @default(autoincrement())
  rolId               Int               @map("rol_id")
  nombre              String            @db.VarChar(120)
  email               String            @unique @db.VarChar(160)
  passwordHash        String            @map("password_hash") @db.VarChar(100)
  debeCambiarPassword Boolean           @default(true) @map("debe_cambiar_password")
  telefono            String?           @db.VarChar(20)
  activo              Boolean           @default(true)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  rol                 Rol               @relation(fields: [rolId], references: [id], onDelete: Restrict)
  cliente             Cliente?
  tecnico             Tecnico?
  restablecimientos   PasswordReset[]
  solicitudesCreadas  Solicitud[]
  asignacionesHechas  Asignacion[]
  historialEstados    HistorialEstado[]
  adjuntosSubidos     Adjunto[]
  notificaciones      Notificacion[]

  @@map("usuarios")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiraAt  DateTime @map("expira_at") @db.Timestamptz(6)
  usado     Boolean  @default(false)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId, usado, expiraAt])
  @@map("password_resets")
}

model Cliente {
  id          Int         @id @default(autoincrement())
  usuarioId   Int         @unique @map("usuario_id")
  razonSocial String      @map("razon_social") @db.VarChar(160)
  ruc         String      @unique @db.Char(13)
  activo      Boolean     @default(true)
  usuario     Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  sedes       Sede[]
  solicitudes Solicitud[]

  @@map("clientes")
}

model Sede {
  id          Int         @id @default(autoincrement())
  clienteId   Int         @map("cliente_id")
  nombre      String      @db.VarChar(120)
  direccion   String      @db.VarChar(200)
  activo      Boolean     @default(true)
  cliente     Cliente     @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  solicitudes Solicitud[]

  @@unique([clienteId, nombre])
  @@index([clienteId])
  @@map("sedes")
}

model Tecnico {
  id             Int                   @id @default(autoincrement())
  usuarioId      Int                   @unique @map("usuario_id")
  disponible     Boolean               @default(true)
  cargaMax       Int                   @default(5) @map("carga_max")
  usuario        Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  especialidades TecnicoEspecialidad[]
  solicitudes    Solicitud[]
  asignaciones   Asignacion[]

  @@map("tecnicos")
}

model Especialidad {
  id         Int                   @id @default(autoincrement())
  nombre     String                @unique @db.VarChar(80)
  activo     Boolean               @default(true)
  tecnicos   TecnicoEspecialidad[]
  categorias Categoria[]

  @@map("especialidades")
}

model TecnicoEspecialidad {
  tecnicoId      Int          @map("tecnico_id")
  especialidadId Int          @map("especialidad_id")
  tecnico        Tecnico      @relation(fields: [tecnicoId], references: [id], onDelete: Restrict)
  especialidad   Especialidad @relation(fields: [especialidadId], references: [id], onDelete: Restrict)

  @@id([tecnicoId, especialidadId])
  @@index([especialidadId])
  @@map("tecnico_especialidad")
}

model Categoria {
  id             Int          @id @default(autoincrement())
  nombre         String       @unique @db.VarChar(80)
  especialidadId Int          @map("especialidad_id")
  activo         Boolean      @default(true)
  especialidad   Especialidad @relation(fields: [especialidadId], references: [id], onDelete: Restrict)
  solicitudes    Solicitud[]

  @@index([especialidadId])
  @@map("categorias")
}

model Prioridad {
  id          Int         @id @default(autoincrement())
  nombre      String      @unique @db.VarChar(20)
  horasSla    Int         @map("horas_sla")
  activo      Boolean     @default(true)
  solicitudes Solicitud[]

  @@map("prioridades")
}

// Catálogo fijo: la máquina de estados del backend depende de estos códigos.
model Estado {
  id                Int               @id @default(autoincrement())
  codigo            String            @unique @db.VarChar(30)
  nombre            String            @db.VarChar(40)
  esFinal           Boolean           @map("es_final")
  solicitudes       Solicitud[]
  historialAnterior HistorialEstado[] @relation("HistorialEstadoAnterior")
  historialNuevo    HistorialEstado[] @relation("HistorialEstadoNuevo")

  @@map("estados")
}

model Solicitud {
  id              Int               @id @default(autoincrement())
  codigo          String            @unique @db.VarChar(20)
  clienteId       Int               @map("cliente_id")
  sedeId          Int               @map("sede_id")
  categoriaId     Int               @map("categoria_id")
  prioridadId     Int               @map("prioridad_id")
  estadoId        Int               @map("estado_id")
  tecnicoActualId Int?              @map("tecnico_actual_id")
  creadoPor       Int               @map("creado_por")
  equipo          String            @db.VarChar(160)
  descripcion     String
  resolucion      String?
  fechaLimite     DateTime          @map("fecha_limite") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt      DateTime?         @map("resolved_at") @db.Timestamptz(6)
  closedAt        DateTime?         @map("closed_at") @db.Timestamptz(6)
  version         Int               @default(1)
  cliente         Cliente           @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  sede            Sede              @relation(fields: [sedeId], references: [id], onDelete: Restrict)
  categoria       Categoria         @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  prioridad       Prioridad         @relation(fields: [prioridadId], references: [id], onDelete: Restrict)
  estado          Estado            @relation(fields: [estadoId], references: [id], onDelete: Restrict)
  tecnicoActual   Tecnico?          @relation(fields: [tecnicoActualId], references: [id], onDelete: Restrict)
  creador         Usuario           @relation(fields: [creadoPor], references: [id], onDelete: Restrict)
  asignaciones    Asignacion[]
  historial       HistorialEstado[]
  adjuntos        Adjunto[]
  notificaciones  Notificacion[]

  @@index([estadoId])
  @@index([clienteId])
  @@index([tecnicoActualId])
  @@index([fechaLimite])
  @@index([createdAt])
  @@map("solicitudes")
}

// Índice único parcial (una sola asignación activa por solicitud) en la migración SQL.
model Asignacion {
  id            Int       @id @default(autoincrement())
  solicitudId   Int       @map("solicitud_id")
  tecnicoId     Int       @map("tecnico_id")
  asignadoPor   Int       @map("asignado_por")
  justificacion String?
  activa        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  solicitud     Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  tecnico       Tecnico   @relation(fields: [tecnicoId], references: [id], onDelete: Restrict)
  asignador     Usuario   @relation(fields: [asignadoPor], references: [id], onDelete: Restrict)

  @@index([solicitudId])
  @@index([tecnicoId, activa])
  @@map("asignaciones")
}

// Inalterable: un trigger de la migración SQL rechaza UPDATE y DELETE.
model HistorialEstado {
  id               Int       @id @default(autoincrement())
  solicitudId      Int       @map("solicitud_id")
  estadoAnteriorId Int?      @map("estado_anterior_id")
  estadoNuevoId    Int       @map("estado_nuevo_id")
  usuarioId        Int       @map("usuario_id")
  comentario       String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  solicitud        Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  estadoAnterior   Estado?   @relation("HistorialEstadoAnterior", fields: [estadoAnteriorId], references: [id], onDelete: Restrict)
  estadoNuevo      Estado    @relation("HistorialEstadoNuevo", fields: [estadoNuevoId], references: [id], onDelete: Restrict)
  usuario          Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([solicitudId, createdAt])
  @@map("historial_estados")
}

model Adjunto {
  id             Int       @id @default(autoincrement())
  solicitudId    Int       @map("solicitud_id")
  nombreOriginal String    @map("nombre_original") @db.VarChar(200)
  ruta           String    @db.VarChar(300)
  mime           String    @db.VarChar(80)
  tamano         Int
  subidoPor      Int       @map("subido_por")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  solicitud      Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  usuario        Usuario   @relation(fields: [subidoPor], references: [id], onDelete: Restrict)

  @@index([solicitudId])
  @@map("adjuntos")
}

model Notificacion {
  id          Int        @id @default(autoincrement())
  usuarioId   Int        @map("usuario_id")
  solicitudId Int?       @map("solicitud_id")
  tipo        String     @db.VarChar(30)
  mensaje     String     @db.VarChar(300)
  leida       Boolean    @default(false)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  usuario     Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  solicitud   Solicitud? @relation(fields: [solicitudId], references: [id], onDelete: Restrict)

  @@index([usuarioId, leida, createdAt])
  @@index([solicitudId])
  @@map("notificaciones")
}
